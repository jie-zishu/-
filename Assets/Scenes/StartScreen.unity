  m_Text: "\u5927\u4F2F\u5728\u4ED636\u5C81\u65F6\u4E0B\u5C97\u4E86\uFF0C\u8FD8\u6709\u4ED6\u7684\u5DE5\u53CB\u4EEC\u3002\u5F53\u65F6\u559C\u7231\u97F3\u4E50\uFF0C\u4F11\u95F2\u65F6\u95F4\u4E30\u5BCC\u7684\u5927\u4F2F\u548C\u4ED6\u7684\u5DE5\u53CB\u4EEC\uFF0C\u66FE\u5728\u4E0B\u5C97\u524D\uFF0C\u751F\u6D3B\u6700\u5E78\u798F\u7684\u9636\u6BB5\u4E00\u8D77\u6253\u9020\u4E86\u4E00\u53F0\u94A2\u7434\u3002\u540E\u6765\u5927\u5BB6\u90FD\u5728\u4E3A\u751F\u8BA1\u53D1\u6101\uFF0C\u4E5F\u6CA1\u6709\u8C01\u6709\u7A7A\u53BB\u7BA1\u8FD9\u53F0\u7434\uFF0C\u4E8E\u662F\u4ED6\u4EEC\u7EDF\u4E00\u51B3\u5B9A\u628A\u7434\u4EA4\u7ED9\u4ED6\u4EEC\u7684\u8001\u5927\uFF0C\u4E5F\u5C31\u662F\u5927\u4F2F\u4FDD\u7BA1\u3002\u5927\u4F2F\u5728\u6751\u91CC\u8FD8\u6709\u5730\uFF0C\u4E0B\u5C97\u540E\uFF0C\u4ED6\u5E26\u7740\u7434\u56DE\u5230\u4E86\u6751\u91CC\uFF0C\u9760\u79CD\u5730\u7B80\u5355\u8FC7\u6D3B\uFF0C\u5076\u5C14\u4ED6\u4E5F\u4F1A\u542C\u89C1\u66FE\u7ECF\u7684\u5DE5\u53CB\u7684\u6D88\u606F\u3002\u7236\u6BCD\u5728\u79BB\u5BB6\u5F88\u8FDC\u7684\u57CE\u5E02\u91CC\u5DE5\u4F5C\u751F\u6D3B\uFF0C\u53EA\u6709\u8FC7\u5E74\u65F6\uFF0C\u7236\u6BCD\u624D\u4F1A\u5E26\u7740\u5C0F\u5B69\u5B50\u7684\u201C\u6211\u201D\u56DE\u6751\u91CC\u4F4F\u51E0\u5929\uFF0C\u5F53\u65F6\u7684\u201C\u6211\u201D\u53EA\u662F\u89C1\u5230\u90A3\u53F0\u8499\u7070\u7684\u7434\uFF0C\u8FD8\u6709\u8FB9\u4E0A\u8001\u7834\u7684\u4E66\u300A\u94A2\u7434\u5236\u9020\u300B\u4E0E\u300A\u62DC\u5384\u94A2\u7434\u57FA\u672C\u6559\u7A0B\u300B\uFF0C\u4F46\u6211\u4E00\u76F4\u4E0D\u77E5\u9053\u5B83\u4EE3\u8868\u7740\u4EC0\u4E48\u3002"
