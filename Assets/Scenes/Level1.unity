  mp3Effect: {fileID: 247969812}
  mp3Billboard: {fileID: 1470182960}
  mp3Trigger: {fileID: 1021716156}
  mp3Dialogues:
  - "\u8FD9\u91CC\u600E\u4E48\u4F1A\u6709MP3\uFF1F\u7B97\u4E86\uFF0C\u60F3\u5FC5\u771F\u662F\u68A6\u91CC\u4EC0\u4E48\u90FD\u6709\u3002"
  performanceBillboard: {fileID: 2101630889}
  performanceTrigger: {fileID: 1772136185}
  explorationCounterUI: {fileID: 1302717987}
  counterText: {fileID: 1399408342}
  goToPianoUI: {fileID: 146222046}
  dialogueController: {fileID: 1628440348}
  pianoInteractionDialogues:
  - "\u4E00\u67B6\u843D\u6EE1\u7070\u5C18\u7684\u65E7\u94A2\u7434\uFF0C\u7434\u952E\u5374\u4F9D\u7136\u5149\u4EAE\u5982\u65B0\u3002"
  - "\u867D\u7136\u6837\u5B50\u770B\u8D77\u6765\u5F88\u5947\u602A\uFF0C\u8FD8\u4F3C\u4E4E\u53EF\u4EE5\u6B63\u5E38\u5F39\u594F\u3002"
  cubeFoundDialogues:
  - "\u4E00\u5F20\u788E\u7EB8\uFF1F\u4E0A\u9762\u600E\u4E48\u5199\u7740\u201C\u591A\u5E74\u4EE5\u524D\u201D\uFF1F\u3002"
  - "\u4E00\u5F20\u788E\u7EB8\uFF0C\u4E00\u9762\u597D\u50CF\u662F\u4E50\u8C31\uFF0C\u53E6\u4E00\u9762\u5199\u7740\u4EC0\u4E48\u3002"
  - "\u4E00\u5F20\u788E\u7EB8\uFF0C\u201C\u79C0\u5170\u201D\uFF1F\u6CA1\u542C\u8BF4\u8FC7\u7684\u540D\u5B57\u3002"
  - "\u4E00\u884C\u97F3\u7B26\uFF1F"
  allCubesFoundDialogues:
  - "\u627E\u5230\u7684\u8FD9\u56DB\u5F20\u788E\u7EB8\u597D\u50CF\u53EF\u4EE5\u62FC\u6210\u4E00\u4E2A\u5B8C\u6574\u7684\u6837\u5B50\u3002"
  - "\u653E\u5728\u51F3\u5B50\u4E0A\u62FC\u597D\u4E86\uFF01\u5B8C\u6574\u770B\u4E00\u770B\u5427\u3002"
  pianoTriggerRadius: 2
  cubeTriggerRadius: 2
  performanceTriggerRadius: 2
  benchSparkleEffect: {fileID: 1744929026}
  readTextUI: {fileID: 14343754}
  exitReadUI: {fileID: 1314351108}
  readBillboard: {fileID: 1681305866}
  benchReadTrigger: {fileID: 1872671364}
  allTextBench: {fileID: 1872671362}
  allTextPiano: {fileID: 348683759}
  readingVCam: {fileID: 1854603571}
  benchReadingEndDialogues:
  - "\u539F\u6765\u662F\u8FD9\u4EFD\u4E50\u8C31...\u4EE5\u524D\u8FC7\u5E74\u56DE\u5BB6\u65F6\u7ECF\u5E38\u542C\u5927\u4F2F\u54FC\u3002"
  - "\u8BF4\u8D77\u6765\uFF0C\u5927\u4F2F\u4F3C\u4E4E\u66FE\u7ECF\u5C31\u662F\u4E0B\u5C97\u5DE5\u4EBA\u7684\u4E00\u5458\uFF0C\u542C\u8001\u7238\u8BF4\uFF0C\u5927\u4F2F\u66FE\u7ECF\u4E5F\u662F\u5728\u57CE\u91CC\u505A\u4E8B\uFF0C\u636E\u8BF4\u5927\u4F2F\u5F53\u65F6\u8FD8\u548C\u5DE5\u53CB\u4EEC\u4E00\u8D77\u9020\u4E86\u592A\u94A2\u7434\u73A9\uFF0C\u540E\u6765\u53D8\u6545\u540E\u624D\u56DE\u8001\u5BB6\u5E38\u4F4F\u7684\u3002"
  - "\u96BE\u9053\u8FD9\u662F\u5927\u4F2F\u66FE\u7ECF\u5446\u8FC7\u7684\u5DE5\u5382\u5417\uFF1F"
  - "...\u53BB\u5E2E\u5927\u4F2F\uFF0C\u5728\u8FD9\u91CC\u518D\u6700\u540E\u6F14\u594F\u4E00\u6B21\u5427\u3002"
